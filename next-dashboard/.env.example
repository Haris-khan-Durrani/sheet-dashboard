# ============================================================================
# 1. GOOGLE SHEET SETTINGS
# ============================================================================
SPREADSHEET_ID=1CKMXX2oa7RNiN8c_1u3uGbXjHcxdba1SGu5Is_9iejw

# Optional: Specify only certain tab(s) to fetch (comma-separated, e.g. Nov 2026,Oct 2026)
# Leave empty to fetch all visible tabs in the spreadsheet
ONLY_TABS=
IGNORE_TABS=

# ============================================================================
# 2. GOOGLE AUTHENTICATION (Choose Option A OR Option B)
# ============================================================================

# --- OPTION A: OAuth2 Client ID & Client Secret (Recommended) ---
# Create in Google Cloud Console > APIs & Services > Credentials > OAuth client ID (Web application)
# Add Authorized redirect URI: http://localhost:3000/auth/google/callback
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:3000/auth/google/callback
# Leave GOOGLE_REFRESH_TOKEN empty on first run: just open http://localhost:3000/auth/google
# and the app will automatically sign you in and save your refresh token!
GOOGLE_REFRESH_TOKEN=

# --- OPTION B: Google Service Account (Alternative) ---
# Either paste the Service Account email & private key below, OR place service-account.json in this folder
GOOGLE_CLIENT_EMAIL=
GOOGLE_PRIVATE_KEY=
GOOGLE_APPLICATION_CREDENTIALS=./service-account.json

# ============================================================================
# 3. SERVER & CACHE SETTINGS
# ============================================================================
PORT=3000
SYNC_INTERVAL_MS=10000
